{
  "manifest_version": 3,
  "name": "Michelin Mole",
  "version": "1.0.0",
  "icons": {
    "128": "icons/small.png",
    "32": "icons/small.png",
    "48": "icons/small.png",
    "16": "icons/small.png"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type"  : "module"
  },
  "action":{"default_popup":"index.html"},
  "permissions": ["scripting"],
  "host_permissions": ["<all_urls>"]
}
